import SecHead from '@components/SecHead.astro';
import Icon from '@components/Icon.astro';
import EmptyState from '@components/EmptyState.astro';
import { projectsConfig } from '@config/index';
import { getProjects } from '@/utils/github';
import { i18n } from '@i18n';
import { sectionNo } from '@/utils/sections';

const owner = projectsConfig.github.replace(/^https?:\/\/github\.com\//, '');
// 板块开关：关闭时不拉取、不渲染（首页板块 / SEC 编号 / hero 导航由 sections.ts 联动）。
// 拉取失败返回 null → 板块降级空态（方案 B，无兜底数据）
const projects = projectsConfig.enabled ? await getProjects() : [];
---

{
  (projects === null || projects.length > 0) && (
    <section id="projects" class="pt-[clamp(70px,11vh,130px)]">
      <div class="wrap">
    <SecHead no={sectionNo.projects} title={i18n.sections.projects.title} en={i18n.sections.projects.en} />

    <div class="border-t border-[var(--hair)] border-x border-b border-[var(--line)] px-3 md:px-4 reveal [&>a:last-of-type]:border-b-0">
      {
        projects === null ? (
          <EmptyState text={i18n.projects.loadFailed} compact />
        ) : (
        projects.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="group block py-[18px] border-b border-[var(--hair)] transition-all duration-250 hover:border-b-[var(--accent)] hover:translate-x-[2px] md:grid md:grid-cols-[96px_1fr_auto] md:gap-[clamp(16px,2.5vw,34px)] md:items-baseline md:py-5"
          >
            {/* 元数据：移动端「编号 · 语言 ↗」一行；md 起编号独占左列、语言落在编号下方 */}
            <span class="flex items-baseline gap-2 font-mono text-[10px] tracking-[0.12em] text-[var(--faint)] md:block">
              <span class="shrink-0 whitespace-nowrap text-[10.5px] font-semibold text-[var(--accent)]">{p.id}</span>
              <span class="flex items-baseline gap-1.5 md:mt-2">
                <span class="w-[6px] h-[6px] rounded-full bg-[var(--accent)] inline-block shrink-0"></span>
                <span>{p.lang}</span>
              </span>
              <span class="ml-auto font-mono text-[10.5px] transition-all group-hover:text-[var(--accent)] group-hover:translate-x-[3px] group-hover:-translate-y-[3px] md:hidden">↗</span>
            </span>

            {/* 主内容块：名称 + 说明。移动端名称拿到整行宽度（不再被三列挤到截断），说明也第一次在移动端露出来 */}
            <span class="block min-w-0">
              <span class="mt-2 md:mt-0 flex items-baseline gap-2 text-[14.5px] md:text-[15px] font-medium leading-[1.5] transition-colors group-hover:text-[var(--accent)]">
                <Icon name="book" class="w-[14px] h-[14px] text-[var(--faint)] group-hover:text-[var(--accent)] transition-colors self-center shrink-0" />
                <span class="[overflow-wrap:anywhere]">{owner}/{p.name}</span>
              </span>
              <span class="mt-1.5 md:mt-1 text-[12.5px] leading-[1.8] text-[var(--soft)] line-clamp-2">{p.description}</span>
            </span>

            {/* 桌面 ↗：移动端那枚在元数据行尾 */}
            <span class="hidden md:block font-mono text-[10.5px] text-[var(--faint)] transition-all group-hover:text-[var(--accent)] group-hover:translate-x-[3px] group-hover:-translate-y-[3px]">↗</span>
          </a>
        ))
        )
      }

    </div>

    <div class="flex justify-between items-center mt-6 font-mono text-[11.5px] tracking-[0.12em] text-[var(--soft)] reveal">
      <span>{i18n.projects.total.replace('{n}', String(projects?.length ?? 0))}</span>
      <a
        href={projectsConfig.github}
        target="_blank"
        rel="noopener"
        class="text-[var(--accent)] border-b border-[var(--accent)] pb-0.5"
      >
        {i18n.projects.more} {projectsConfig.github.replace(/^https?:\/\//, '').toUpperCase()}
      </a>
    </div>
  </div>
    </section>
  )
}
