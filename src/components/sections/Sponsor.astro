import SecHead from '@components/SecHead.astro';
import OptImage from '@components/OptImage.astro';
import { donationConfig, externalLinksConfig, siteConfig } from '@config/index';
import { i18n } from '@i18n';
import { sectionNo } from '@/utils/sections';
import { externalLinkAttrs } from '@/utils/externalLinks';

interface Props {
  /** SEC 编号位；默认取首页顺延编号,页面级复用时传入档案术语(如 APPX) */
  no?: string;
  compact?: boolean;
}
const { no = sectionNo.sponsor, compact = false } = Astro.props;

const afdian = donationConfig.methods.find((m) => m.key === 'afdian');
const afdianDisplay = (afdian?.url ?? '').replace(/^https?:\/\//, '').replace(/\/$/, '');
const afdianLinkAttrs = externalLinkAttrs(afdian?.url ?? '', siteConfig.site.url, externalLinksConfig);
---

{
  compact && (
    <section id="sponsor" class="pt-[clamp(56px,8vh,90px)]">
      <div class="wrap">
        <div class="detail-appendix mx-auto max-w-[680px]">
          <SecHead no={no} title={i18n.sections.sponsor.title} en={i18n.sections.sponsor.en} />
          <div class="flex flex-col gap-5 border border-[var(--line)] bg-[var(--panel)] px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
            <div>
              <p class="text-[15px] leading-[1.8] text-[var(--soft)]">
                {donationConfig.messageLead} <strong class="font-semibold border-b-2 border-[var(--accent)]">
                  <svg class="inline-block w-[0.92em] h-[0.92em] align-[-0.12em] mr-[0.18em] text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 2v2"></path>
                    <path d="M10 2v2"></path>
                    <path d="M14 2v2"></path>
                    <path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"></path>
                  </svg>
                  {donationConfig.messageCoffee}
                </strong>
                {donationConfig.messageTail}
              </p>
              <a
                href={afdian?.url}
                {...afdianLinkAttrs}
                class="mt-3 inline-block font-mono text-[11px] tracking-[0.12em] text-[var(--accent)] transition-colors hover:text-[var(--ink)]"
              >
                {i18n.sponsor.afdian}{afdianDisplay} →
              </a>
            </div>
            <div class="flex shrink-0 gap-3">
              {
                donationConfig.methods
                  .filter((m) => m.image || m.key === 'alipay')
                  .map((m) => (
                    <div class="w-[92px] border border-[var(--line)] bg-[var(--panel)] p-1">
                      <div class={`aspect-square border border-[var(--hair)] grid place-items-center overflow-hidden ${m.image ? 'img-ph img-ph--asset' : ''}`}>
                        {m.image ? (
                          <OptImage src={m.image} alt={i18n.sponsor.qr.replace('{name}', m.name)} class="w-full h-full object-cover" />
                        ) : (
                          <span class="font-mono text-[9px] tracking-[0.1em] text-[var(--faint)] text-center leading-relaxed">
                            {m.name.toUpperCase()} QR<br />{i18n.sponsor.qrPlaceholder}
                          </span>
                        )}
                      </div>
                      <div class="pt-1 font-mono text-[9px] tracking-[0.1em] text-[var(--soft)]">{m.name.toUpperCase()}</div>
                    </div>
                  ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

{!compact && (
<section id="sponsor" class="pt-[clamp(70px,11vh,130px)]">
  <div class="wrap">
    <SecHead no={no} title={i18n.sections.sponsor.title} en={i18n.sections.sponsor.en} />

    <div class="grid grid-cols-1 min-[860px]:grid-cols-[1fr_auto] gap-[clamp(26px,5vw,72px)] items-center reveal">
      <div class="relative min-[860px]:mt-3.5 max-w-[520px]">
        <span class="absolute -top-[38px] right-0 max-[860px]:static max-[860px]:inline-block max-[860px]:mb-5 border-2 border-[var(--accent)] text-[var(--accent)] font-mono text-[13px] tracking-[0.4em] pl-5 pr-4 py-2 rotate-[5deg] font-semibold opacity-90">
          {i18n.sponsor.stamp}
        </span>
        <p class="text-[clamp(19px,2.6vw,28px)] font-light leading-[1.9]">
          {donationConfig.messageLead} <b class="font-semibold border-b-2 border-[var(--accent)]"><svg class="inline-block w-[0.92em] h-[0.92em] align-[-0.12em] mr-[0.18em] text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2v2"></path><path d="M10 2v2"></path><path d="M14 2v2"></path><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"></path></svg>{donationConfig.messageCoffee}</b>{donationConfig.messageTail}
        </p>
        <a
          href={afdian?.url}
          {...afdianLinkAttrs}
          class="inline-block mt-8 font-mono text-xs tracking-[0.12em] text-[var(--accent)] border-b border-[var(--accent)] pb-1"
        >
          {i18n.sponsor.afdian}{afdianDisplay} →
        </a>
      </div>

      <div class="flex gap-[clamp(18px,3vw,36px)] flex-wrap">
        {
          donationConfig.methods
            .filter((m) => m.image || m.key === 'alipay')
            .map((m) => (
              <div class="border border-[var(--line)] bg-[var(--panel)] p-1.5 w-[172px]">
                <div class={`aspect-square border border-[var(--hair)] grid place-items-center overflow-hidden ${m.image ? 'img-ph img-ph--asset' : ''}`}>
                  {m.image ? (
                    <OptImage src={m.image} alt={i18n.sponsor.qr.replace('{name}', m.name)} class="w-full h-full object-cover" />
                  ) : (
                    <span class="font-mono text-[10px] tracking-[0.14em] text-[var(--faint)] text-center leading-relaxed">
                      {m.name.toUpperCase()} QR<br />{i18n.sponsor.qrPlaceholder}
                    </span>
                  )}
                </div>
                <div class="flex justify-between pt-2 px-1 font-mono text-[10px] tracking-[0.14em] text-[var(--soft)]">
                  <span>{m.name.toUpperCase()}</span>
                  <span>{m.key === 'wechat' ? '01' : '02'}</span>
                </div>
              </div>
            ))
        }
      </div>
    </div>
  </div>
</section>
)}
