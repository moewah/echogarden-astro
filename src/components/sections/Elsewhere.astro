import SecHead from '@components/SecHead.astro';
import Icon from '@components/Icon.astro';
import { elsewhereConfig } from '@config/index';
import { i18n } from '@i18n';
import { sectionNo } from '@/utils/sections';

const displayUrl = (url: string) =>
  url.replace(/^mailto:/, '').replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<section id="links" class="pt-[clamp(70px,11vh,130px)]">
  <div class="wrap">
    <SecHead no={sectionNo.links} title={i18n.sections.elsewhere.title} en={i18n.sections.elsewhere.en} />

    <div class="grid md:grid-cols-2 gap-x-[clamp(24px,5vw,72px)] reveal">
      {
        elsewhereConfig
          .filter((link) => link.enabled !== false)
          .map((link, i) => (
          <a
            href={link.url}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener' : undefined}
            class="group flex items-baseline py-5 border-b border-[var(--hair)]"
          >
            <span class="font-mono text-[13px] text-[var(--accent)] font-semibold min-w-[44px] transition-colors group-hover:bg-[var(--accent)] group-hover:text-white">
              {String(i + 1).padStart(3, '0')}
            </span>
            <Icon
              name={link.icon}
              class="w-[18px] h-[18px] ml-3.5 mr-2.5 text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors self-center shrink-0"
            />
            <span class="font-mono text-[15px] font-medium tracking-[0.08em] uppercase whitespace-nowrap">{link.name}</span>
            <span class="flex-1 mx-4 border-b border-dotted border-[var(--faint)] translate-y-[-4px]"></span>
            <span class="font-mono text-[11px] text-[var(--faint)] transition-colors group-hover:text-[var(--accent)]">
              {displayUrl(link.url)}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
