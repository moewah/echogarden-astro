// 全站右下角悬浮公众号二维码入口（可控开关），点击向上展开卡片。
import { siteConfig } from '@config/index';
import OptImage from '@components/OptImage.astro';
import { i18n } from '@i18n';
import type { ImageMetadata } from 'astro';

const { wechat } = siteConfig;
const isLocalImage = (src: unknown): src is ImageMetadata =>
  typeof src === 'object' && src !== null && 'src' in src;
---

{
  wechat.enabled && (
    <details class="wechat-qr">
      <summary class="wechat-qr-trigger" aria-label={i18n.wechatQr.button}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="4" width="6" height="6"></rect>
          <rect x="14" y="4" width="6" height="6"></rect>
          <rect x="4" y="14" width="6" height="6"></rect>
          <path d="M14 14h2v2h-2zM18 14h2v2h-2zM14 18h2v2h-2zM18 18h2v2h-2z"></path>
        </svg>
      </summary>
      <div class="wechat-qr-card">
        <span class="wechat-qr-image img-ph img-ph--asset">
          {
            isLocalImage(wechat.qr) ? (
              <OptImage src={wechat.qr} alt={wechat.label} class="block h-auto w-full" />
            ) : (
              <img src={wechat.qr} alt={wechat.label} class="block h-auto w-full" loading="lazy" />
            )
          }
        </span>
        <strong>{wechat.label}</strong>
        {wechat.handle && <small class="wechat-qr-handle">{wechat.handle}</small>}
        {wechat.note && (
          <>
            <span class="wechat-qr-divider" aria-hidden="true"></span>
            <small class="wechat-qr-note">{wechat.note}</small>
          </>
        )}
      </div>
    </details>
  )
}

<style>
  .wechat-qr {
    position: fixed;
    right: 18px;
    bottom: calc(var(--float-base) + 8px);
    z-index: 40;
  }
  .wechat-qr summary {
    list-style: none;
  }
  .wechat-qr summary::-webkit-details-marker {
    display: none;
  }
  .wechat-qr-trigger {
    display: grid;
    width: var(--float-size);
    height: var(--float-size);
    place-items: center;
    border: 1.5px solid var(--accent);
    background: var(--bg);
    color: var(--accent);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .wechat-qr-trigger:hover,
  .wechat-qr[open] .wechat-qr-trigger {
    background: var(--accent);
    color: var(--bg);
  }
  .wechat-qr-trigger:focus-visible {
    outline: 1.5px solid var(--accent);
    outline-offset: 3px;
  }
  .wechat-qr-trigger svg {
    width: 17px;
    height: 17px;
  }
  .wechat-qr-card {
    position: absolute;
    right: calc(100% + 8px);
    bottom: 0;
    display: flex;
    width: 150px;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 10px;
  }
  .wechat-qr-image {
    display: block;
    width: 100%;
  }
  .wechat-qr-card strong,
  .wechat-qr-card small {
    text-align: center;
  }
  .wechat-qr-card strong {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .wechat-qr-card small {
    font-family: var(--font-mono);
    line-height: 1.5;
  }
  .wechat-qr-handle {
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .wechat-qr-divider {
    width: 100%;
    height: 1px;
    background: var(--hair);
  }
  .wechat-qr-note {
    color: var(--faint);
    font-size: 8.5px;
    letter-spacing: 0.04em;
  }
  @media (prefers-reduced-motion: reduce) {
    .wechat-qr-trigger {
      transition: none;
    }
  }
</style>
