// 空状态占位:虚线框 + mono 提示,副内容(如版本行)走 slot
interface Props {
  text: string;
  compact?: boolean;
}
const { text, compact = false } = Astro.props;
---

<div class:list={['text-center reveal', { 'border border-dashed border-[var(--hair)] px-5 py-10': !compact }]}>
  <div class={compact ? 'py-8' : ''}>
    <p class="font-mono text-[13px] text-[var(--faint)]">{text}</p>
    <slot />
  </div>
</div>
