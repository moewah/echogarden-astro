// 数据统计脚本注入组件
// 各平台按自身 enabled 开关独立渲染，全部关闭时零输出。
import { analyticsConfig } from '@config/index';
import { gaScript, clarityScript, umamiScript, trackEventBridge, umamiToGaBridge } from '@/utils/analytics';

const { googleAnalytics, microsoftClarity, umami } = analyticsConfig;
const gaHtml = gaScript(googleAnalytics);
const clarityHtml = clarityScript(microsoftClarity);
const umamiHtml = umamiScript(umami);
const hasScripts = gaHtml || clarityHtml || umamiHtml;
---

{
  hasScripts && (
    <>
      {gaHtml && <Fragment set:html={gaHtml} />}
      {clarityHtml && <Fragment set:html={clarityHtml} />}
      {umamiHtml && <Fragment set:html={umamiHtml} />}
      {hasScripts && <Fragment set:html={trackEventBridge()} />}
      {gaHtml && <Fragment set:html={umamiToGaBridge()} />}
    </>
  )
}
