import EmptyState from '@components/EmptyState.astro';
import Pagination from '@components/Pagination.astro';
import PhotoImg from '@components/PhotoImg.astro';
import { i18n } from '@i18n';
import { formatDate } from '@/utils/date';
import { weeklyIssueLabel } from '@/utils/weekly';
import { umamiEvent } from '@/utils/analytics';
import type { WeeklyPost } from '@/utils/weekly';

interface Props {
  posts: WeeklyPost[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<section class="pb-[clamp(70px,11vh,130px)]">
  <div class="wrap">
    {
      posts.length === 0 ? (
        <EmptyState text={i18n.weekly.empty} />
      ) : (
        <>
          <div class="border-b border-[var(--line)]">
            {posts.map((p, i) => (
              <a
                href={`/weekly/${p.id}/`}
                class="group grid items-center gap-x-8 gap-y-4 border-t border-[var(--line)] py-6 md:grid-cols-[300px_1fr] md:py-7"
                {...umamiEvent('weekly-click', { id: p.id, surface: 'index' })}
              >
                <figure class="contents">
                  <div class="img-ph img-ph--post aspect-video overflow-hidden border border-[var(--hair)] bg-[var(--bg)]">
                    <PhotoImg
                      src={p.data.cover}
                      alt={p.data.title}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : undefined}
                      width={600}
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                    />
                  </div>
                  <figcaption class="min-w-0">
                    <div class="flex items-baseline gap-4 font-mono">
                      <span class="text-[12px] font-semibold tracking-[0.14em] text-[var(--accent)]">
                        {weeklyIssueLabel(p.data.issue)}
                      </span>
                      <span class="text-[10.5px] tracking-[0.08em] text-[var(--faint)]">{formatDate(p.data.date)}</span>
                    </div>
                    <h2 class="mt-2.5 text-[20px] font-semibold leading-[1.4] transition-colors group-hover:text-[var(--accent)]">
                      {p.data.title}
                    </h2>
                    <p class="mt-2 text-[13.5px] leading-[1.8] text-[var(--soft)] line-clamp-3 md:line-clamp-2">{p.data.description}</p>
                    {p.data.tags && p.data.tags.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[10.5px] tracking-[0.1em] text-[var(--faint)]">
                        {p.data.tags.map((t) => (
                          <span># {t}</span>
                        ))}
                      </div>
                    )}
                  </figcaption>
                </figure>
              </a>
            ))}
          </div>
          <Pagination base="/weekly/" current={currentPage} total={totalPages} />
        </>
      )
    }
  </div>
</section>
