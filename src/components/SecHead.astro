interface Props {
  no: string;
  title: string;
  en: string;
}
const { no, title, en } = Astro.props;
---

<div class="sec-head flex items-baseline gap-5 border-b border-[var(--line)] pb-4 mb-[clamp(30px,5vh,54px)] reveal">
  <span class="font-mono text-xs tracking-[0.2em] text-[var(--accent)] font-semibold">{no}</span>
  <h2 class="text-[clamp(26px,3.8vw,42px)] font-light tracking-[0.04em] text-[var(--ink)]">{title}</h2>
  <span class="font-mono text-[10.5px] tracking-[0.24em] text-[var(--faint)] uppercase ml-auto hidden sm:block">{en}</span>
</div>
