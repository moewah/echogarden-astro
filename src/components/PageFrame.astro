<div class="page-frame" aria-hidden="true">
  <i></i><i></i><i></i><i></i>
</div>

<style>
  .page-frame {
    position: fixed;
    inset: 12px;
    border: 1px solid var(--hair);
    pointer-events: none;
    z-index: 55;
  }

  .page-frame i {
    position: absolute;
    width: 15px;
    height: 15px;
  }

  .page-frame i::before,
  .page-frame i::after {
    content: '';
    position: absolute;
    background: var(--faint);
  }

  .page-frame i::before {
    left: 7px;
    top: 0;
    width: 1px;
    height: 15px;
  }

  .page-frame i::after {
    top: 7px;
    left: 0;
    width: 15px;
    height: 1px;
  }

  .page-frame i:nth-child(1) { top: -8px; left: -8px; }
  .page-frame i:nth-child(2) { top: -8px; right: -8px; }
  .page-frame i:nth-child(3) { bottom: -8px; left: -8px; }
  .page-frame i:nth-child(4) { bottom: -8px; right: -8px; }
</style>
