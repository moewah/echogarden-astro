import { i18n } from '@i18n';

interface Props {
  base: string;
  current: number;
  total: number;
}

const { base, current, total } = Astro.props;

function href(page: number): string {
  if (page <= 1) return base;
  return `${base}page/${page}/`;
}
---

{
  total > 1 && (
    <nav
      class="mt-[clamp(36px,6vh,60px)] flex items-center justify-between border-y border-[var(--hair)] py-4 font-mono text-[11px] tracking-[0.12em]"
      aria-label={i18n.pagination.label}
    >
      {current > 1 ? (
        <a href={href(current - 1)} class="text-[var(--soft)] transition-colors hover:text-[var(--accent)]">
          ← {i18n.pagination.prev}
        </a>
      ) : (
        <span class="cursor-not-allowed text-[var(--faint)]">← {i18n.pagination.prev}</span>
      )}

      <span class="text-[var(--faint)]">
        <span class="text-[var(--accent)]">{String(current).padStart(2, '0')}</span>
        {' / '}
        {String(total).padStart(2, '0')}
      </span>

      {current < total ? (
        <a href={href(current + 1)} class="text-[var(--soft)] transition-colors hover:text-[var(--accent)]">
          {i18n.pagination.next} →
        </a>
      ) : (
        <span class="cursor-not-allowed text-[var(--faint)]">{i18n.pagination.next} →</span>
      )}
    </nav>
  )
}
