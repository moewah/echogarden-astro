import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/PageHeader.astro';
import Guestbook from '@components/sections/Guestbook.astro';
import Notice from '@components/sections/Notice.astro';
import Footer from '@components/Footer.astro';
import { siteConfig } from '@config/index';
import { i18n } from '@i18n';
---

<Layout
  title={siteConfig.site.seo.pages.guestbook.title}
  description={siteConfig.site.seo.pages.guestbook.description}
  keywords={siteConfig.site.seo.pages.guestbook.keywords}
>
  <PageHeader title={i18n.sections.guestbook.title} tagline={i18n.page.guestbookTagline} no={i18n.sections.guestbook.no}>
    <div class="shrink-0 w-[clamp(32px,5vw,52px)] h-[clamp(32px,5vw,52px)] border border-[var(--hair)] rounded-full grid place-items-center text-[var(--faint)]" aria-hidden="true">
      <svg class="w-[clamp(17px,2.7vw,28px)] h-[clamp(17px,2.7vw,28px)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.9 16.1C1 12.2 1 5.8 4.9 1.9"></path>
        <path d="M7.8 4.7a6.14 6.14 0 0 0-.8 7.5"></path>
        <circle cx="12" cy="9" r="2"></circle>
        <path d="M16.2 4.8c2 2 2.26 5.11.8 7.47"></path>
        <path d="M19.1 1.9a9.96 9.96 0 0 1 0 14.1"></path>
        <path d="M9.5 18h5"></path>
        <path d="m8 22 4-11 4 11"></path>
      </svg>
    </div>
  </PageHeader>
  <div class="pt-[clamp(40px,6vh,80px)]">
    <Guestbook showHead={false} />
  </div>
  <Notice />
  <Footer no={i18n.sections.guestbook.no} />
</Layout>
