import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/PageHeader.astro';
import AlbumList from '@components/AlbumList.astro';
import Notice from '@components/sections/Notice.astro';
import Footer from '@components/Footer.astro';
import { siteConfig, albumsConfig } from '@config/index';
import { i18n } from '@i18n';
import { getSortedAlbums } from '@/utils/albums';
import { paginate, getPageParams, pageUrl as buildPageUrl } from '@/utils/pagination';
import { archiveCode } from '@/utils/archive';

export async function getStaticPaths() {
  if (!albumsConfig.enabled) return [];
  const albums = await getSortedAlbums();
  const totalPages = Math.max(1, Math.ceil(albums.length / albumsConfig.perPage));
  return getPageParams(totalPages);
}

const currentPage = Number(Astro.params.page);
const albums = await getSortedAlbums();
const { items, totalPages } = paginate(albums, albumsConfig.perPage, currentPage);
const siteUrl = siteConfig.site.url.replace(/\/?$/, '/');
const canonical = buildPageUrl(siteUrl, 'photos/', currentPage);
const prev = currentPage > 2 ? buildPageUrl(siteUrl, 'photos/', currentPage - 1) : buildPageUrl(siteUrl, 'photos/', 1);
const next = currentPage < totalPages ? buildPageUrl(siteUrl, 'photos/', currentPage + 1) : undefined;
const title = `${siteConfig.site.seo.pages.photos.title} · ${i18n.pagination.page.replace('{n}', String(currentPage))}`;
const pageCode = archiveCode('MW-ALB', albumsConfig.archiveNo);
---

<Layout
  title={title}
  description={siteConfig.site.seo.pages.photos.description}
  keywords={siteConfig.site.seo.pages.photos.keywords}
  canonical={canonical}
  prev={prev}
  next={next}
  robots="noindex, follow"
>
  <PageHeader title={i18n.sections.albums.title} tagline={i18n.page.photosTagline} no={pageCode}>
    <div class="grid h-[clamp(32px,5vw,52px)] w-[clamp(32px,5vw,52px)] shrink-0 place-items-center rounded-full border border-[var(--hair)] text-[var(--faint)]" aria-hidden="true">
      <svg class="h-[clamp(17px,2.7vw,28px)] w-[clamp(17px,2.7vw,28px)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18"></rect>
        <circle cx="9" cy="9" r="2"></circle>
        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
      </svg>
    </div>
  </PageHeader>

  <AlbumList
    albums={items}
    startIndex={(currentPage - 1) * albumsConfig.perPage}
    currentPage={currentPage}
    totalPages={totalPages}
  />

  <Notice />
  <Footer no={pageCode} />
</Layout>
