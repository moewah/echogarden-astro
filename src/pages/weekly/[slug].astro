<!-- 代码块复制按钮(文案经 data 属性从 i18n 注入) -->
<div id="code-copy-i18n" data-copy={i18n.weekly.copy} data-copied={i18n.weekly.copied} hidden></div>
<script>
  const weeklyBody = document.querySelector<HTMLElement>('.weekly-reading-body');
  const weeklyToc = document.querySelector<HTMLElement>('.weekly-toc');
  const weeklyTocInner = weeklyToc?.querySelector<HTMLElement>('.weekly-toc-inner');
  const weeklyTocList = weeklyToc?.querySelector<HTMLOListElement>('.weekly-toc-list');
  const weeklyHeadings = weeklyBody ? [...weeklyBody.querySelectorAll<HTMLElement>('h2, h3, h4')] : [];

  if (weeklyToc && weeklyTocList && weeklyHeadings.length > 0) {
    const tocItems = weeklyHeadings.map((heading, index) => {
      if (!heading.id) heading.id = `weekly-section-${index + 1}`;
      const text = heading.textContent?.trim() ?? '';
      const level = heading.tagName.toLowerCase();
      const item = document.createElement('li');
      const link = document.createElement('a');
      const label = document.createElement('span');
      const bar = document.createElement('span');

      link.href = `#${heading.id}`;
      link.className = 'weekly-toc-link';
      link.dataset.level = level;
      item.dataset.level = level;
      link.setAttribute('aria-label', text);
      label.className = 'weekly-toc-label';
      label.textContent = text;
      bar.className = 'weekly-toc-bar';
      link.append(label, bar);
      item.append(link);
      weeklyTocList.append(item);
      return { heading, link };
    });

    weeklyToc.hidden = false;

    const clearHover = () => {
      tocItems.forEach(({ link }) => delete link.dataset.hovered);
    };
    const setRailState = (state: 'scroll' | 'hover') => {
      weeklyToc.dataset.state = state;
    };
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let waveFrame = 0;
    let pendingWaveY = 0;
    const clearWave = () => {
      if (waveFrame) cancelAnimationFrame(waveFrame);
      waveFrame = 0;
      tocItems.forEach(({ link }) => link.style.setProperty('--toc-wave', '0'));
    };
    const applyWave = (clientY: number) => {
      if (reduceMotion) return;
      const radius = 72;
      tocItems.forEach(({ link }) => {
        const rect = link.getBoundingClientRect();
        const distance = Math.abs(clientY - (rect.top + rect.height / 2));
        const wave = Math.max(0, 1 - distance / radius);
        link.style.setProperty('--toc-wave', wave.toFixed(3));
      });
    };
    const setWave = (clientY: number) => {
      if (reduceMotion) return;
      pendingWaveY = clientY;
      if (waveFrame) return;
      waveFrame = requestAnimationFrame(() => {
        waveFrame = 0;
        applyWave(pendingWaveY);
      });
    };
    const setWaveAtIndex = (index: number) => {
      if (reduceMotion) return;
      const rect = tocItems[index]?.link.getBoundingClientRect();
      if (rect) applyWave(rect.top + rect.height / 2);
    };

    weeklyTocList.addEventListener('pointerenter', () => setRailState('hover'));
    weeklyTocList.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'touch') setWave(event.clientY);
    });
    weeklyTocList.addEventListener('pointerleave', () => {
      clearHover();
      clearWave();
      setRailState('scroll');
    });
    tocItems.forEach(({ link }, index) => {
      link.addEventListener('pointerenter', () => {
        link.dataset.hovered = 'true';
      });
      link.addEventListener('pointerleave', () => {
        delete link.dataset.hovered;
      });
      link.addEventListener('focus', () => {
        setRailState('hover');
        link.dataset.hovered = 'true';
        setWaveAtIndex(index);
      });
      link.addEventListener('blur', () => {
        delete link.dataset.hovered;
        if (!weeklyTocInner?.matches(':focus-within')) {
          clearWave();
          setRailState('scroll');
        }
      });
      link.addEventListener('click', () => {
        const track = (window as any).trackEvent;
        if (typeof track === 'function') {
          track('weekly-toc-click', {
            id: weeklyToc?.dataset.id ?? '',
            issue: weeklyToc?.dataset.issue ?? '',
            level: link.dataset.level || '',
          });
        }
      });
    });

    const setActive = (heading: HTMLElement) => {
      tocItems.forEach(({ heading: itemHeading, link }) => {
        if (itemHeading === heading) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    const currentHeading = weeklyHeadings.reduce(
      (active, heading) => (heading.getBoundingClientRect().top <= 160 ? heading : active),
      weeklyHeadings[0],
    );
    setActive(currentHeading);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target as HTMLElement);
      },
      { rootMargin: '-18% 0px -68% 0px', threshold: 0 },
    );
    weeklyHeadings.forEach((heading) => observer.observe(heading));

    // 移动端目录面板：从 tocItems 渲染，点击跳锚点后关闭
    const dirToggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    const dirPanel = document.querySelector<HTMLElement>('#weekly-dir-panel');
    const dirList = document.querySelector<HTMLOListElement>('#weekly-dir-list');
    const trackTocClick = (level: string) => {
      const track = (window as any).trackEvent;
      if (typeof track === 'function') {
        track('weekly-toc-click', {
          id: weeklyToc?.dataset.id ?? '',
          issue: weeklyToc?.dataset.issue ?? '',
          level,
        });
      }
    };
    if (dirToggle && dirPanel && dirList) {
      dirToggle.addEventListener('click', () => {
        trackTocClick('panel-open');
        dirList.innerHTML = '';
        tocItems.forEach(({ link, heading }, index) => {
          const li = document.createElement('li');
          li.className = 'weekly-dir-item';
          if (link.hasAttribute('aria-current')) li.classList.add('is-current');
          const a = document.createElement('a');
          a.href = link.getAttribute('href') || `#${heading.id}`;
          a.textContent = `${String(index + 1).padStart(2, '0')} · ${link.getAttribute('aria-label') || ''}`;
          a.dataset.level = link.dataset.level || '';
          li.append(a);
          dirList.append(li);
        });
        dirPanel.hidden = false;
      });
      dirList.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const item = target.closest<HTMLElement>('.weekly-dir-item a');
        if (item) trackTocClick(item.dataset.level || 'panel-item');
        dirPanel.hidden = true;
      });
      document.querySelector('[data-dir-close]')?.addEventListener('click', () => {
        dirPanel.hidden = true;
      });
    }
  }

  // 无小标题：右侧轨道没有内容可挂，保持隐藏；悬浮目录按钮也一并隐藏（只留 AI 辅助），
  // 并在 body 上留标记，供 CSS 把返回顶部下移一格（链上不留空洞）
  if (weeklyHeadings.length === 0) {
    const dirToggleButton = document.querySelector<HTMLElement>('[data-toc-toggle]');
    if (dirToggleButton) dirToggleButton.hidden = true;
    document.body.classList.add('weekly-no-toc');
  }

  // 悬浮工具组：滚动进入正文后淡入（与返回顶部同阈值 400），不自动淡出
  const weeklyTools = document.querySelector<HTMLElement>('.weekly-tools');
  if (weeklyTools) {
    const syncTools = () => {
      weeklyTools.classList.toggle('show', window.scrollY > 400);
    };
    window.addEventListener('scroll', syncTools, { passive: true });
    syncTools();
  }

  const aiReadingButtons = document.querySelectorAll<HTMLButtonElement>('[data-ai-reading]');
  aiReadingButtons.forEach((aiReadingButton) => {
    const promptTemplate = aiReadingButton.dataset.prompt || '';
    const articleUrl = aiReadingButton.dataset.url || '';
    const buttonLabel = aiReadingButton.dataset.buttonLabel || '';
    const copiedLabel = aiReadingButton.dataset.copiedLabel || '';
    const failedLabel = aiReadingButton.dataset.failedLabel || '';
    let resetTimer = 0;

    const setAiReadingState = (state: 'copied' | 'failed' | '') => {
      window.clearTimeout(resetTimer);
      aiReadingButton.dataset.state = state;
      aiReadingButton.setAttribute('aria-label', state === 'copied' ? copiedLabel : state === 'failed' ? failedLabel : buttonLabel);
      if (state) {
        resetTimer = window.setTimeout(() => setAiReadingState(''), 2200);
      }
    };

    const copyPrompt = async (text: string) => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }
      } catch {
        // 非安全上下文或剪贴板权限失败时，继续尝试 textarea 兼容方案。
      }
      const buffer = document.createElement('textarea');
      buffer.className = 'ai-reading-copy-buffer';
      buffer.value = text;
      buffer.setAttribute('readonly', '');
      document.body.append(buffer);
      buffer.select();
      const copied = (document as any).execCommand('copy');
      buffer.remove();
      if (!copied) throw new Error('Clipboard unavailable');
    };

    aiReadingButton.addEventListener('click', async () => {
      const prompt = promptTemplate.replace('{canonical URL}', articleUrl);
      try {
        await copyPrompt(prompt);
        setAiReadingState('copied');
      } catch {
        setAiReadingState('failed');
      }
    });
  });

  const shareButtons = document.querySelectorAll<HTMLButtonElement>('[data-share-url]');
  shareButtons.forEach((shareButton) => {
    const shareRow = shareButton.closest<HTMLElement>('.weekly-share');
    const label = shareButton.querySelector<HTMLElement>('.weekly-share-label');
    const copyLabel = shareRow?.querySelector<HTMLElement>('.weekly-share-copy');
    const menu = shareRow?.querySelector<HTMLElement>('[data-share-menu]');
    const url = shareButton.dataset.shareUrl || '';
    const title = shareButton.dataset.shareTitle || '';
    const text = shareButton.dataset.shareText || '';
    const buttonLabel = shareButton.dataset.buttonLabel || '';
    const copiedLabel = shareButton.dataset.copiedLabel || '';
    const failedLabel = shareButton.dataset.failedLabel || '';
    const defaultCopyLabel = copyLabel?.textContent || '';
    let resetTimer = 0;

    const setShareState = (state: 'copied' | 'failed' | '') => {
      window.clearTimeout(resetTimer);
      shareButton.dataset.state = state;
      const nextLabel = state === 'copied' ? copiedLabel : state === 'failed' ? failedLabel : buttonLabel;
      if (label) label.textContent = nextLabel;
      if (copyLabel) copyLabel.textContent = nextLabel === buttonLabel ? defaultCopyLabel : nextLabel;
      shareButton.setAttribute('aria-label', nextLabel);
      if (state) resetTimer = window.setTimeout(() => setShareState(''), 2200);
    };

    const setMenuState = (isOpen: boolean) => {
      if (!menu) return;
      menu.hidden = !isOpen;
      shareButton.setAttribute('aria-expanded', String(isOpen));
    };

    const copyUrl = async () => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(url);
          return;
        }
      } catch {
        // 非安全上下文或剪贴板权限失败时，继续尝试 textarea 兼容方案。
      }
      const buffer = document.createElement('textarea');
      buffer.className = 'weekly-share-copy-buffer';
      buffer.value = url;
      buffer.setAttribute('readonly', '');
      document.body.append(buffer);
      buffer.select();
      const copied = (document as any).execCommand('copy');
      buffer.remove();
      if (!copied) throw new Error('Clipboard unavailable');
    };

    const shareWithSystem = async () => {
      if (typeof navigator.share === 'function') {
        try {
          await navigator.share({ title, text, url });
          return;
        } catch (error) {
          if (error instanceof Error && error.name === 'AbortError') return;
          setShareState('failed');
          return;
        }
      }

      try {
        await copyUrl();
        setShareState('copied');
      } catch {
        setShareState('failed');
      }
    };

    const openChannel = (channel: string) => {
      const encodedUrl = encodeURIComponent(url);
      const encodedTitle = encodeURIComponent(title);
      const encodedText = encodeURIComponent(text ? `${title} — ${text}` : title);
      const encodedArticle = encodeURIComponent(`${title}\n${url}`);
      const channelUrls: Record<string, string> = {
        x: `https://x.com/intent/tweet?url=${encodedUrl}&text=${encodedText}`,
        telegram: `https://t.me/share/url?url=${encodedUrl}&text=${encodedText}`,
        linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
        bluesky: `https://bsky.app/intent/compose?text=${encodedArticle}`,
        mastodon: `https://share.joinmastodon.org/?text=${encodedArticle}`,
        email: `mailto:?subject=${encodedTitle}&body=${encodeURIComponent(`${text}\n\n${url}`)}`,
      };
      const shareUrl = channelUrls[channel];
      if (!shareUrl) return;
      window.open(shareUrl, '_blank', 'noopener,noreferrer');
    };

    shareButton.addEventListener('click', () => {
      if (!menu) {
        void shareWithSystem();
        return;
      }
      setMenuState(menu.hidden);
    });

    menu?.querySelectorAll<HTMLButtonElement>('[data-share-channel]').forEach((channelButton) => {
      channelButton.addEventListener('click', async () => {
        const channel = channelButton.dataset.shareChannel || '';
        setMenuState(false);
        if (channel === 'system') {
          await shareWithSystem();
          return;
        }
        if (channel === 'copy') {
          try {
            await copyUrl();
            setShareState('copied');
          } catch {
            setShareState('failed');
          }
          return;
        }
        openChannel(channel);
      });
    });

    document.addEventListener('click', (event) => {
      if (menu && !shareRow?.contains(event.target as Node)) setMenuState(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu && !menu.hidden) {
        setMenuState(false);
        shareButton.focus();
      }
    });
  });

  const rssCopyButton = document.querySelector<HTMLButtonElement>('[data-copy-url]');
  rssCopyButton?.addEventListener('click', async () => {
    const url = rssCopyButton.dataset.copyUrl || '';
    const copyLabel = rssCopyButton.dataset.copyLabel || '';
    const copiedLabel = rssCopyButton.dataset.copiedLabel || '';
    const failedLabel = rssCopyButton.dataset.failedLabel || '';
    const statusLabel = rssCopyButton.querySelector<HTMLElement>('.weekly-rss-copy-label');
    let copied = false;

    try {
      if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
      await navigator.clipboard.writeText(url);
      copied = true;
    } catch {
      try {
        const textarea = document.createElement('textarea');
        textarea.value = url;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        copied = (document as any).execCommand('copy');
        textarea.remove();
      } catch {
        copied = false;
      }
    }

    if (statusLabel) statusLabel.textContent = copied ? copiedLabel : failedLabel;
    rssCopyButton.classList.toggle('is-copied', copied);
    rssCopyButton.classList.toggle('is-failed', !copied);
    window.setTimeout(() => {
      if (statusLabel) statusLabel.textContent = copyLabel;
      rssCopyButton.classList.remove('is-copied', 'is-failed');
    }, 1500);
  });

  // 文末引用块：复制 Markdown 引用行（与 RSS 复制同款 clipboard + textarea 降级）
  const citationCopyButton = document.querySelector<HTMLButtonElement>('[data-copy-value]');
  citationCopyButton?.addEventListener('click', async () => {
    const value = citationCopyButton.dataset.copyValue || '';
    const copyLabel = citationCopyButton.dataset.copyLabel || '';
    const copiedLabel = citationCopyButton.dataset.copiedLabel || '';
    const failedLabel = citationCopyButton.dataset.failedLabel || '';
    const statusLabel = citationCopyButton.querySelector<HTMLElement>('.weekly-copyright-copy-label');
    let copied = false;

    try {
      if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
      await navigator.clipboard.writeText(value);
      copied = true;
    } catch {
      try {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        copied = (document as any).execCommand('copy');
        textarea.remove();
      } catch {
        copied = false;
      }
    }

    if (statusLabel) statusLabel.textContent = copied ? copiedLabel : failedLabel;
    citationCopyButton.classList.toggle('is-copied', copied);
    citationCopyButton.classList.toggle('is-failed', !copied);
    window.setTimeout(() => {
      if (statusLabel) statusLabel.textContent = copyLabel;
      citationCopyButton.classList.remove('is-copied', 'is-failed');
    }, 1500);
  });

  const i18nEl = document.getElementById('code-copy-i18n');
  const labelCopy = i18nEl?.dataset.copy || 'COPY';
  const labelCopied = i18nEl?.dataset.copied || 'COPIED';
  document.querySelectorAll<HTMLElement>('.post-body pre.astro-code').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.textContent = labelCopy;
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        // 非安全上下文(localhost 除外) clipboard 不可用,走 textarea 兼容
        const ta = document.createElement('textarea');
        ta.value = code;
        document.body.appendChild(ta);
        ta.select();
        (document as any).execCommand('copy');
        ta.remove();
      }
      btn.textContent = labelCopied;
      btn.classList.add('is-copied');
      setTimeout(() => {
        btn.textContent = labelCopy;
        btn.classList.remove('is-copied');
      }, 1500);
    });
    pre.appendChild(btn);
  });
</script>

<script is:inline>
  // ===== 阅读深度：25% / 50% / 75% / 100%，每阈值只上报一次 =====
  (function () {
    var toc = document.querySelector('.weekly-toc');
    if (!toc) return;
    var id = toc.getAttribute('data-id') || '';
    var issue = toc.getAttribute('data-issue') || '';
    var readMin = parseInt(toc.getAttribute('data-read-min') || '0', 10);
    var readGate = readMin * 30; // 完读停留门槛（秒）：预估阅读时长的一半
    var loadAt = Date.now(); // 页面加载时刻，用于完读判定的停留时长
    var tracked = {};
    var readCompleteSent = false;
    var ticking = false;

    // 完读判定：滚到 100% 且已停留达门槛才上报（Reader 证据）
    function markReadComplete() {
      if (readCompleteSent || !tracked[100] || !(readGate > 0)) return;
      var track = window['trackEvent'];
      if (typeof track !== 'function') return;
      readCompleteSent = true;
      track('weekly-read-complete', { id: id, issue: issue });
    }

    function report() {
      ticking = false;
      var el = document.querySelector('.weekly-reading-body');
      if (!el) return;
      var rect = el.getBoundingClientRect();
      var docTop = rect.top + window.scrollY; // 正文容器顶在文档中的位置
      var max = el.offsetHeight - window.innerHeight; // 正文底部完全露出需要的滚动量（与当前滚动位置无关）
      if (max <= 0) return;
      var scrolled = window.scrollY - docTop;
      var ratio = Math.min(1, Math.max(0, scrolled / max));
      [25, 50, 75, 100].forEach(function (depth) {
        if (ratio * 100 >= depth && !tracked[depth]) {
          tracked[depth] = true;
          var track = window['trackEvent'];
          if (typeof track === 'function') {
            track('weekly-scroll-depth', { depth: depth, id: id, issue: issue });
          }
          // 完读判定：滚到 100% 且停留 ≥ 预估阅读时长的一半，才计为「读完正文」（Reader）
          // 滚到底时停留不足则挂定时器到门槛复核——读者可能先滚到底、再慢慢读完
          if (depth === 100) {
            var remain = readGate * 1000 - (Date.now() - loadAt);
            if (remain <= 0) markReadComplete();
            else setTimeout(markReadComplete, remain);
          }
        }
      });
    }

    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(report);
    }, { passive: true });
    report();
  })();

  // ===== 互文链接点击：正文内 /weekly/ callback 链接 → weekly-callback-click =====
  (function () {
    var body = document.querySelector('.weekly-reading-body');
    if (!body) return;
    var id = (document.querySelector('.weekly-toc')?.getAttribute('data-id') || '');
    var issue = (document.querySelector('.weekly-toc')?.getAttribute('data-issue') || '');
    body.addEventListener('click', function (ev) {
      var t = ev.target;
      var a = t && t.closest ? t.closest('a') : null;
      if (!a) return;
      var href = a.getAttribute('href') || '';
      var m = /^\/?weekly\/([a-z0-9-]+)\/?/.exec(href);
      if (!m) return; // 只统计站内周刊链接
      var track = window['trackEvent'];
      if (typeof track === 'function') {
        track('weekly-callback-click', { id: id, target: m[1], issue: issue });
      }
    });
  })();
</script>
