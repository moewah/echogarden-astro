---
// 秩序与回响 | EchoGarden | NEW
// Repository: https://github.com/moewah/echogarden-astro.git
// Copyright (c) EchoGarden (https://github.com/moewah/echogarden-astro)
// Licensed under MIT
import { render } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import SecHead from '@components/SecHead.astro';
import PhotoImg from '@components/PhotoImg.astro';
import Comments from '@components/Comments.astro';
import Sponsor from '@components/sections/Sponsor.astro';
import Notice from '@components/sections/Notice.astro';
import Footer from '@components/Footer.astro';
import Lightbox from '@components/Lightbox.astro';
import ReadingMode from '@components/ReadingMode.astro';
import { weeklyConfig, artalkConfig, siteConfig, routesConfig } from '@config/index';
import { i18n } from '@i18n';
import { ogImage } from '@/utils/og';
import { formatDate } from '@/utils/date';
import { getSortedWeekly, adjacentWeekly, weeklyIssueLabel, weeklyAuthor, type WeeklyPost } from '@/utils/weekly';
import { archiveCode } from '@/utils/archive';
import { getArtalkVersionStatus } from '@/utils/artalk';
import { umamiEvent } from '@/utils/analytics';

export async function getStaticPaths() {
  if (!weeklyConfig.enabled) return [];
  const posts = await getSortedWeekly();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: WeeklyPost;
}
const { post } = Astro.props;
const { Content } = await render(post);

const sorted = await getSortedWeekly();
const history = sorted.filter((p) => p.id !== post.id);
const { prev, next } = adjacentWeekly(sorted, post.id);
const issue = post.data.issue;
const pageCode = archiveCode('MW-WKL', weeklyConfig.archiveNo);
// 预估阅读时长（分钟）：正文去 Markdown 符号后按 400 字/分钟估算，用于完读判定（weekly-read-complete）
const readMin = Math.max(1, Math.round(((post.body ?? '').replace(/[#>*\`\[\]()!\-\d\s]/g, '').length) / 400));
// og:image 用本期封面（本地图走构建压缩，远程原样），type=article
const ogImg = await ogImage(post.data.cover);

// 文章页结构化数据：Article
const siteUrl = siteConfig.site.url.replace(/\/?$/, '/');
const rssUrl = new URL(routesConfig.rss, siteUrl).toString();
const articleUrl = new URL(Astro.url.pathname, siteUrl).toString();
const articleId = `${articleUrl}#article`;
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': articleId,
  url: articleUrl,
  headline: post.data.title,
  description: post.data.description,
  image: ogImg,
  datePublished: new Date(post.data.date).toISOString().split('T')[0],
  dateModified: new Date(post.data.updated ?? post.data.date).toISOString().split('T')[0],
  author: { '@id': personId },
  publisher: { '@id': websiteId },
};
const artalkVersionStatus = weeklyConfig.comments ? await getArtalkVersionStatus() : 'unconfigured';
// 文末引用块的引用行（标题 / 作者 / 原文链接），纯文本不依赖 Markdown，供读者一键复制
const citation = `${post.data.title} · ${weeklyAuthor(post)} · ${articleUrl}`;
---

<Layout title={post.data.title} description={post.data.description} image={ogImg} type="article" mainEntity={{ '@id': articleId }} keywords={post.data.tags}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  {/* 阅读增强：周刊详情页作用区（原始态背景，开关见 readingConfig） */}
  <ReadingMode />
  <section class="pt-[70px]">
    <div class="wrap pt-[clamp(20px,4vh,44px)]">
      <div class="weekly-reading-header">
        <div>
          <div class="font-mono text-[10.5px] tracking-[0.12em]">
            <span class="font-semibold text-[var(--accent)]">{weeklyIssueLabel(issue)}</span>
          </div>
          <h1 class="mt-[clamp(28px,6vh,72px)] text-[clamp(32px,5vw,52px)] font-light leading-[1.3] tracking-[0.04em]">{post.data.title}</h1>
          <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10.5px] tracking-[0.1em] text-[var(--faint)]">
            <span class="inline-flex items-center gap-1.5">
              <svg class="h-[13px] w-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
              {weeklyAuthor(post)}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="h-[13px] w-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path d="M16 2v4M8 2v4M3 10h18" />
              </svg>
              {formatDate(post.data.date)}
            </span>
            {
              post.data.updated && (
                <span class="inline-flex items-center gap-1.5">
                  <svg class="h-[13px] w-[13px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 12a9 9 0 0 1 15-6.7L21 8" />
                    <path d="M21 3v5h-5" />
                    <path d="M21 12a9 9 0 0 1-15 6.7L3 16" />
                    <path d="M3 21v-5h5" />
                  </svg>
                  {i18n.weekly.updated.replace('{date}', formatDate(post.data.updated))}
                </span>
              )
            }
          </div>
        </div>
      </div>

      <div class="mt-16 border-b border-[var(--line)]"></div>

      <div class="weekly-reading-layout">
        <article class="weekly-article mx-auto min-w-0 max-w-[720px]">
          <div class="img-ph img-ph--post mt-7 aspect-video overflow-hidden border border-[var(--hair)] bg-[var(--bg)] reveal">
            <PhotoImg
              src={post.data.cover}
              alt={post.data.title}
              loading="eager"
              fetchpriority="high"
              preset="card"
              class="h-full w-full object-cover cursor-pointer"
              data-lightbox-trigger
              data-lightbox-title={post.data.title}
            />
          </div>

          <p class="mx-auto mt-7 max-w-[680px] border-l-2 border-[var(--accent)] pl-5 text-[15.5px] leading-[1.9] text-[var(--soft)]">
            {post.data.description}
          </p>

          <div class="markdown-body post-body weekly-reading-body mx-auto mt-8 max-w-[680px]">
            <Content />
          </div>

          <!-- 文末分享：读后才做的动作（PC 与移动一致）；读中要用的目录 / AI 辅助在右下角悬浮 -->
          <div class="weekly-share">
            <div id="weekly-share-menu" class="weekly-share-menu" data-share-menu hidden role="menu" aria-label={i18n.weekly.shareMenuAria}>
              <div class="weekly-share-menu-head">
                <span>{i18n.weekly.shareMenuLabel}</span>
                <span>{i18n.weekly.shareMenuCount}</span>
              </div>
              <div class="weekly-share-menu-grid">
                <button type="button" class="weekly-share-channel is-primary" data-share-channel="system" data-share-label={i18n.weekly.shareSystem} role="menuitem"><span class="weekly-share-channel-code">SYS</span><span>{i18n.weekly.shareSystem}</span></button>
                <button type="button" class="weekly-share-channel" data-share-channel="x" data-share-label={i18n.weekly.shareX} role="menuitem"><span class="weekly-share-channel-code">X</span><span>{i18n.weekly.shareX}</span></button>
                <button type="button" class="weekly-share-channel" data-share-channel="telegram" data-share-label={i18n.weekly.shareTelegram} role="menuitem"><span class="weekly-share-channel-code">TG</span><span>{i18n.weekly.shareTelegram}</span></button>
                <button type="button" class="weekly-share-channel" data-share-channel="linkedin" data-share-label={i18n.weekly.shareLinkedIn} role="menuitem"><span class="weekly-share-channel-code">IN</span><span>{i18n.weekly.shareLinkedIn}</span></button>
                <button type="button" class="weekly-share-channel" data-share-channel="bluesky" data-share-label={i18n.weekly.shareBluesky} role="menuitem"><span class="weekly-share-channel-code">BS</span><span>{i18n.weekly.shareBluesky}</span></button>
                <button type="button" class="weekly-share-channel" data-share-channel="mastodon" data-share-label={i18n.weekly.shareMastodon} role="menuitem"><span class="weekly-share-channel-code">MA</span><span>{i18n.weekly.shareMastodon}</span></button>
                <button type="button" class="weekly-share-channel" data-share-channel="email" data-share-label={i18n.weekly.shareEmail} role="menuitem"><span class="weekly-share-channel-code">MAIL</span><span>{i18n.weekly.shareEmail}</span></button>
                <button type="button" class="weekly-share-channel" data-share-channel="copy" data-share-label={i18n.weekly.shareCopyLink} role="menuitem"><span class="weekly-share-channel-code">URL</span><span>{i18n.weekly.shareCopyLink}</span></button>
              </div>
            </div>
            <span class="weekly-share-meta">
              <span class="weekly-share-mark" aria-hidden="true">↗</span>
              <span class="weekly-share-copy-wrap">
                <span class="weekly-share-kicker">{i18n.weekly.shareKicker}</span>
                <span class="weekly-share-copy" aria-live="polite">{i18n.weekly.shareArticle}</span>
              </span>
            </span>
            <button
              type="button"
              class="weekly-share-btn"
              aria-label={i18n.weekly.share}
              aria-controls="weekly-share-menu"
              aria-expanded="false"
              aria-haspopup="menu"
              data-share-menu-toggle
              data-share-url={articleUrl}
              data-share-title={post.data.title}
              data-share-text={post.data.description}
              data-button-label={i18n.weekly.share}
              data-copied-label={i18n.weekly.shareCopied}
              data-failed-label={i18n.weekly.shareFailed}
              {...umamiEvent('weekly-share', { id: post.id, issue, surface: 'detail-filing' })}
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5l7 -4" /><path d="M8.5 9.5l7 4" /><path d="M6 12a2.5 2.5 0 1 0 0 -5a2.5 2.5 0 0 0 0 5" /><path d="M18 9a2.5 2.5 0 1 0 0 -5a2.5 2.5 0 0 0 0 5" /><path d="M18 20a2.5 2.5 0 1 0 0 -5a2.5 2.5 0 0 0 0 5" /></svg>
              <span class="weekly-share-label">{i18n.weekly.share}</span>
            </button>
          </div>

          {
            post.data.tags && post.data.tags.length > 0 && (
              <div class="mx-auto mt-9 flex max-w-[680px] flex-wrap gap-x-4 gap-y-1 font-mono text-[10.5px] tracking-[0.1em] text-[var(--faint)]">
                {post.data.tags.map((t) => (
                  <span># {t}</span>
                ))}
              </div>
            )
          }

          <!-- 文末引用块：作者、标题、原文链接由当前文章动态生成，条款见 siteConfig.copyright；折叠用原生 details，无专属 JS -->
          <details class="weekly-copyright">
            <summary class="weekly-copyright-summary">
              <span class="weekly-copyright-mark" aria-hidden="true"></span>
              <span>{i18n.weekly.copyrightLabel}</span>
              {siteConfig.copyright.brief && <span class="weekly-copyright-brief">{siteConfig.copyright.brief}</span>}
            </summary>
            <dl class="weekly-copyright-rows">
              <div class="weekly-copyright-row">
                <dt>{i18n.weekly.copyrightSource}</dt>
                <dd><a href={articleUrl}>{articleUrl}</a></dd>
              </div>
              <div class="weekly-copyright-row">
                <dt>{i18n.weekly.copyrightCitation}</dt>
                <dd class="weekly-copyright-cite">
                  <span class="weekly-copyright-quote"><span class="weekly-copyright-title">{post.data.title}</span> · {weeklyAuthor(post)} · {articleUrl}</span>
                  <button
                    type="button"
                    class="weekly-copyright-copy"
                    data-copy-value={citation}
                    data-copy-label={i18n.weekly.copyrightCopy}
                    data-copied-label={i18n.weekly.copyrightCopied}
                    data-failed-label={i18n.weekly.copyrightCopyFailed}
                  >
                    <span class="weekly-copyright-copy-label">{i18n.weekly.copyrightCopy}</span>
                  </button>
                </dd>
              </div>
              {
                siteConfig.copyright.terms && (
                  <div class="weekly-copyright-row">
                    <dt>{i18n.weekly.copyrightTerms}</dt>
                    <dd>{siteConfig.copyright.terms}</dd>
                  </div>
                )
              }
            </dl>
          </details>

          <!-- 上一期 / 下一期 -->
          <nav class="mx-auto mt-10 grid max-w-[680px] grid-cols-2 items-center gap-3 border-t border-[var(--line)] pt-5 font-mono text-[11px] tracking-[0.12em]">
            {
              prev ? (
                <a
                  href={`/weekly/${prev.id}/`}
                  class="justify-self-start text-[var(--soft)] transition-colors hover:text-[var(--accent)]"
                  {...umamiEvent('weekly-prev-next', { id: post.id, issue, dir: 'prev' })}
                >
                  ← {i18n.weekly.prev}
                  <span class="text-[var(--faint)]"> · {prev.data.issue}</span>
                </a>
              ) : (
                <span />
              )
            }
            {
              next ? (
                <a
                  href={`/weekly/${next.id}/`}
                  class="justify-self-end text-[var(--soft)] transition-colors hover:text-[var(--accent)]"
                  {...umamiEvent('weekly-prev-next', { id: post.id, issue, dir: 'next' })}
                >
                  {i18n.weekly.next}
                  <span class="text-[var(--faint)]"> · {next.data.issue}</span> →
                </a>
              ) : (
                <span />
              )
            }
          </nav>
        </article>

        <nav class="weekly-toc" aria-label={i18n.weekly.toc} data-state="scroll" data-id={post.id} data-issue={issue} data-read-min={readMin} hidden>
          <div class="weekly-toc-inner">
            <ol class="weekly-toc-list" />
          </div>
        </nav>
      </div>

      <Lightbox />

      <!-- 阅读中工具（悬浮，z-40，与右下角既有悬浮件同层同形）：DOM 顺序 = 视觉顺序，目录在上、AI 辅助在下；返回顶部在最上（自动淡出不留洞） -->
      <div class="weekly-tools">
        <button type="button" class="weekly-tools-btn weekly-tools-toc" aria-label={i18n.weekly.toc} data-toc-toggle>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16" /><path d="M4 12h10" /><path d="M4 17h16" /></svg>
        </button>
        <button
          type="button"
          class="weekly-tools-btn"
          aria-label={i18n.weekly.aiReading}
          data-ai-reading
          data-button-label={i18n.weekly.aiReading}
          data-url={articleUrl}
          data-prompt={i18n.weekly.aiReadingPrompt}
          data-copied-label={i18n.weekly.aiReadingCopied}
          data-failed-label={i18n.weekly.aiReadingCopyFailed}
          {...umamiEvent('weekly-ai-reading', { id: post.id, issue, surface: 'detail-float' })}
        >
          <span class="weekly-tools-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3" /><path d="M8 9h8a3 3 0 0 1 3 3v5a3 3 0 0 1 -3 3h-8a3 3 0 0 1 -3 -3v-5a3 3 0 0 1 3 -3" /><path d="M9 13h.01" /><path d="M15 13h.01" /><path d="M9 17h6" /><path d="M3 13v2" /><path d="M21 13v2" /></svg>
          </span>
          <span class="weekly-tools-icon-done" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
          </span>
          <span class="weekly-tools-hint weekly-tools-hint-copied" aria-hidden="true">{i18n.weekly.aiReadingCopied}</span>
          <span class="weekly-tools-hint weekly-tools-hint-failed" aria-hidden="true">{i18n.weekly.aiReadingCopyFailed}</span>
        </button>
      </div>

      <!-- 移动端目录面板（由悬浮目录按钮唤起，仅移动端使用） -->
      <div class="weekly-dir-panel" id="weekly-dir-panel" hidden>
        <div class="weekly-dir-head">
          <span>DIRECTORY</span>
          <button type="button" class="weekly-dir-close" data-dir-close>{i18n.weekly.tocClose}</button>
        </div>
        <ol class="weekly-dir-list" id="weekly-dir-list"></ol>
      </div>

      <aside class="weekly-history mx-auto mt-12 max-w-[680px]">
        <div class="flex items-baseline justify-between border-b border-[var(--line)] pb-3 font-mono text-[10.5px] tracking-[0.12em] text-[var(--faint)]">
          <div class="flex items-baseline gap-3">
            <h2 class="font-semibold text-[var(--soft)]">{i18n.weekly.history}</h2>
            <span>{String(history.length).padStart(2, '0')}</span>
          </div>
          <a href="/weekly/" class="text-[var(--faint)] transition-colors hover:text-[var(--accent)]">{i18n.weekly.home} →</a>
        </div>
        <ol class="mt-1 grid md:grid-cols-2 md:gap-x-8">
          {
            history.slice(0, weeklyConfig.historyLimit).map((p) => {
              return (
                <li>
                  <a
                    href={`/weekly/${p.id}/`}
                    class="group flex min-w-0 items-baseline gap-3 border-b border-[var(--hair)] py-2.5"
                  >
                    <span
                      class="shrink-0 font-mono text-[10.5px] tracking-[0.08em] text-[var(--faint)] transition-colors group-hover:text-[var(--accent)]"
                    >
                      {weeklyIssueLabel(p.data.issue)}
                    </span>
                    <span
                      class="min-w-0 truncate text-[12.5px] leading-[1.5] text-[var(--soft)] transition-colors group-hover:text-[var(--accent)]"
                    >
                      {p.data.title}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ol>
      </aside>

      <div class="weekly-rss mx-auto mt-12 max-w-[680px] border-y border-[var(--hair)] py-4">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <svg class="weekly-rss-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
              <circle cx="5" cy="19" r="1" />
            </svg>
            <div>
              <p class="font-mono text-[10.5px] tracking-[0.18em] text-[var(--soft)]">{i18n.weekly.rssLabel}</p>
              <p class="mt-1 text-[12px] leading-[1.6] text-[var(--faint)]">{i18n.weekly.rssHint}</p>
            </div>
          </div>
          <div class="flex w-full gap-2 sm:w-auto" role="group" aria-label={i18n.weekly.rssLabel}>
            <a
              href={rssUrl}
              target="_blank"
              rel="noopener"
              class="weekly-rss-action weekly-rss-open flex-1 sm:flex-none"
              {...umamiEvent('weekly-rss-open', { id: post.id, issue, surface: 'detail' })}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 5h5M5 5v5M5 5l6 6" />
                <path d="M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-7" />
                <path d="M13 5h6v6M19 5l-7 7" />
              </svg>
              {i18n.weekly.rssOpen}
            </a>
            <button
              type="button"
              class="weekly-rss-action weekly-rss-copy flex-1 sm:flex-none"
              data-copy-url={rssUrl}
              data-copy-label={i18n.weekly.rssCopy}
              data-copied-label={i18n.weekly.rssCopied}
              data-failed-label={i18n.weekly.rssCopyFailed}
              {...umamiEvent('weekly-rss-copy', { id: post.id, issue, surface: 'detail' })}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="8" y="8" width="11" height="12" />
                <path d="M16 8V5a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h2" />
              </svg>
              <span class="weekly-rss-copy-label">{i18n.weekly.rssCopy}</span>
            </button>
          </div>
        </div>
      </div>
      {
        weeklyConfig.comments && (

          <div class="weekly-comments detail-appendix mx-auto mt-[clamp(56px,8vh,90px)] max-w-[680px]">
            <SecHead no="CORR" title={i18n.weekly.comments} en={i18n.weekly.commentsEn} />
            <div class="border border-[var(--line)] bg-[var(--panel)]">
              <div class="p-4 md:p-6">
                {artalkVersionStatus === 'ready' ? (
                  <Comments />
                ) : (
                  <p class="border border-dashed border-[var(--hair)] px-5 py-8 text-center font-mono text-[13px] text-[var(--faint)]">
                    {artalkVersionStatus === 'mismatch'
                      ? i18n.guestbook.versionMismatch
                      : artalkVersionStatus === 'unavailable'
                        ? i18n.guestbook.versionCheckFailed
                        : i18n.weekly.commentsOff}
                    <span class="block mt-2.5 font-mono text-[11px] tracking-[0.12em] text-[var(--faint)]">{i18n.guestbook.disabledVer.replace('{n}', artalkConfig.version)}</span>
                  </p>
                )}
              </div>
              <div class="border-t border-[var(--line)] px-6 py-3 font-mono text-[10px] tracking-[0.16em] text-[var(--faint)]">
                {i18n.guestbook.artalk}
              </div>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- 复用赞助板块(编号位用档案术语 APPX = 附录) -->
  <Sponsor no="APPX" compact />

  <Notice />
  <Footer no={pageCode} />
</Layout>

<style is:global>
  .weekly-reading-layout {
    position: relative;
  }
  /* 文末分享：方案 01 索引簿；读后才做的动作，PC 与移动一致 */
  .weekly-share {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    max-width: 680px;
    margin-top: 40px;
    margin-inline: auto;
    border-left: 2px solid var(--accent);
    padding: 9px 13px 9px;
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }
  .weekly-share-menu {
    position: absolute;
    right: 13px;
