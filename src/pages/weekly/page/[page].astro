import Layout from '@layouts/Layout.astro';
import PageHeader from '@components/PageHeader.astro';
import WeeklyList from '@components/WeeklyList.astro';
import Notice from '@components/sections/Notice.astro';
import Footer from '@components/Footer.astro';
import { weeklyConfig, siteConfig } from '@config/index';
import { i18n } from '@i18n';
import { getSortedWeekly } from '@/utils/weekly';
import { paginate, getPageParams, pageUrl as buildPageUrl } from '@/utils/pagination';
import { archiveCode } from '@/utils/archive';

export async function getStaticPaths() {
  if (!weeklyConfig.enabled) return [];
  const posts = await getSortedWeekly();
  const totalPages = Math.max(1, Math.ceil(posts.length / weeklyConfig.perPage));
  return getPageParams(totalPages);
}

const currentPage = Number(Astro.params.page);
const posts = await getSortedWeekly();
const { items, totalPages } = paginate(posts, weeklyConfig.perPage, currentPage);
const siteUrl = siteConfig.site.url.replace(/\/?$/, '/');
const canonical = buildPageUrl(siteUrl, 'weekly/', currentPage);
const prev = currentPage > 2 ? buildPageUrl(siteUrl, 'weekly/', currentPage - 1) : buildPageUrl(siteUrl, 'weekly/', 1);
const next = currentPage < totalPages ? buildPageUrl(siteUrl, 'weekly/', currentPage + 1) : undefined;
const title = `${siteConfig.site.seo.pages.weekly.title} · ${i18n.pagination.page.replace('{n}', String(currentPage))}`;
const pageCode = archiveCode('MW-WKL', weeklyConfig.archiveNo);
---

<Layout
  title={title}
  description={siteConfig.site.seo.pages.weekly.description}
  keywords={siteConfig.site.seo.pages.weekly.keywords}
  canonical={canonical}
  prev={prev}
  next={next}
  robots="noindex, follow"
>
  <PageHeader
    no={pageCode}
    title={i18n.sections.weeklyPage.title}
    tagline={i18n.page.weeklyTagline}
  >
    <div class="grid h-[clamp(32px,5vw,52px)] w-[clamp(32px,5vw,52px)] shrink-0 place-items-center rounded-full border border-[var(--hair)] text-[var(--faint)]" aria-hidden="true">
      <svg class="h-[clamp(17px,2.7vw,28px)] w-[clamp(17px,2.7vw,28px)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2" />
        <path d="M18 14h-8" />
        <path d="M15 18h-5" />
        <path d="M10 6h8v4h-8V6Z" />
      </svg>
    </div>
  </PageHeader>

  <WeeklyList posts={items} currentPage={currentPage} totalPages={totalPages} />

  <Notice />
  <Footer no={pageCode} />
</Layout>
